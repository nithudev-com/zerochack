NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WEB_HOST_PORT=3000
API_HOST_PORT=4000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://zerochack:zerochack_local@localhost:5432/zerochack?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-base64-encoded-32-byte-key
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-another-base64-encoded-32-byte-key
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-distinct-base64-encoded-32-byte-key
# Enable only after the care migration and all API/worker instances are updated.
CARE_ENABLED=false
CARE_REPAIR_ENABLED=false
CARE_REVIEW_ENABLED=false
CARE_REVIEW_BUDGET_MICROS=5000000
CARE_RELEASE_ENABLED=false
# CARE_ARTIFACT_KEY=replace-with-a-distinct-base64-encoded-32-byte-key
CARE_JOB_BUDGET_MICROS=500000
# CARE_VAULT_KEY=replace-with-an-independent-base64-encoded-32-byte-key
REPORT_SIGNING_KEY=replace-with-an-independent-32-character-signing-secret
METRICS_TOKEN=replace-with-an-independent-32-character-metrics-token
SESSION_TTL_HOURS=24
EMAIL_TOKEN_TTL_MINUTES=60
RESET_TOKEN_TTL_MINUTES=30
MFA_CHALLENGE_TTL_MINUTES=5
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=security@zerochack.local
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false
SCANNER_TIMEOUT_MS=10000
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1048576
