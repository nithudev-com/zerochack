{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codebandage:offline-candidate-broker:request:v1",
  "title": "Offline candidate broker request v1; unavailable until actual runtime gates pass",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "scope", "jobId", "files", "inputDigest"],
  "properties": {
    "version": {"const": 1},
    "profile": {"const": "PYTHON_UNITTEST_V1"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "websiteId", "runId", "environment"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/uuid"},
        "websiteId": {"$ref": "#/$defs/uuid"},
        "runId": {"$ref": "#/$defs/uuid"},
        "environment": {"const": "STAGING"}
      }
    },
    "jobId": {"$ref": "#/$defs/uuid"},
    "inputDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}\\.py$", "not": {"enum": ["sitecustomize.py", "usercustomize.py"]}},
          "content": {"type": "string", "maxLength": 262144}
        }
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  },
  "$comment": "Python broker additionally enforces unique flat filenames, at least one test_*.py, combined source UTF-8 bytes <=262144, no NUL/surrogate content, total request <=1048576 and five-second input deadline. inputDigest is SHA256 of Python json.dumps(request without inputDigest, sort_keys=True, separators=(',', ':'), ensure_ascii=True, allow_nan=False).encode('ascii'). JSON Schema alone is not admission authority."
}
