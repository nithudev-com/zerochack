generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AccountStatus {
  REGISTERED
  EMAIL_VERIFIED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MFA_CHALLENGE
}

enum AgencyClientStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AgencyClientPermission {
  CLIENT_READ
  WEBSITES_READ
  SECURITY_READ
  TICKETS_READ
  SUBSCRIPTIONS_READ
  BILLING_READ
  QUOTES_READ
  QUOTES_MANAGE
}

enum WebsiteLifecycle {
  ACTIVE
  ARCHIVED
}

enum ConnectionStatus {
  PENDING
  VERIFIED
  FAILED
}

enum SecurityStatus {
  UNKNOWN
  HEALTHY
  ATTENTION
  CRITICAL
}

enum ServiceStatus {
  NOT_CONFIGURED
  PENDING
  ACTIVE
  PAUSED
  ERROR
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityFixScope {
  ISSUE
  TASK
  PROJECT
}

enum SecurityFixOrderStatus {
  CHECKOUT_PENDING
  PAID
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  IN_REMEDIATION
  RESOLVED
  ACCEPTED_RISK
  FALSE_POSITIVE
  REOPENED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BackupPurpose {
  MANUAL
  SCHEDULED
  PRE_REMEDIATION
}

enum SecurityEventType {
  AVAILABILITY
  TLS
  DNS
  HEADERS
  INTEGRITY
  SECURITY_INDICATOR
}

enum SecurityEventStatus {
  OPEN
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

enum TicketStatus {
  CREATED
  QUEUED
  ASSIGNED
  ACCEPTED
  AWAITING_AUTHORIZATION
  AUTHORIZED
  BACKUP_PENDING
  READY
  IN_PROGRESS
  AWAITING_CUSTOMER
  POST_SCAN
  RESOLVED
  CLOSED
  ESCALATED
  CANCELLED
}

enum RemediationSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  COMPLETED
}

enum RemediationRunStatus {
  PENDING
  RUNNING
  AWAITING_POST_SCAN
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WarrantyClaimStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  RESOLVED
}

enum ChatMessageType {
  CUSTOMER
  AI
  SPECIALIST
  SYSTEM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
}

enum AttributionStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  REJECTED
}

enum CommissionKind {
  ONE_TIME
  RECURRING
}

enum CommissionCalculation {
  PERCENTAGE
  FIXED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAYABLE
  PAID
  REVERSED
  CANCELLED
}

enum AffiliatePayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum IntegrationType {
  EMAIL
  STORAGE
  SECURITY_ENGINE
  WEBSOCKET
}

enum IntegrationHealthStatus {
  NOT_CONFIGURED
  HEALTHY
  DEGRADED
  FAILED
  UNKNOWN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum VerificationMethod {
  DNS
  HTTP
  CONNECTOR
}

enum AiHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum AiUsageStatus {
  PENDING
  SUCCEEDED
  FAILED
  REJECTED
}

enum CommunicationEventType {
  REGISTRATION
  EMAIL_VERIFICATION
  APPROVAL
  SUSPENSION
  SCAN_STARTED
  SCAN_COMPLETED
  CRITICAL_FINDING
  MONITORING_ALERT
  BACKUP_SUCCESS
  BACKUP_FAILURE
  TICKET_CREATED
  SPECIALIST_ASSIGNED
  AUTHORIZATION_REQUESTED
  REMEDIATION_STARTED
  REMEDIATION_COMPLETED
  POST_SCAN
  WARRANTY
  SUBSCRIPTION
  PAYMENT
  INVOICE
  AFFILIATE_COMMISSION
  PAYOUT
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  RETRYING
  DELIVERED
  FAILED
  SUPPRESSED
}

enum ReportType {
  SECURITY_SCAN
  REMEDIATION
  MONITORING
  BEFORE_AFTER
}

model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  email                     String                     @unique @db.VarChar(320)
  passwordHash              String?                    @map("password_hash") @db.VarChar(255)
  displayName               String?                    @map("display_name") @db.VarChar(120)
  status                    AccountStatus              @default(REGISTERED)
  emailVerifiedAt           DateTime?                  @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts       Int                        @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?                  @map("locked_until") @db.Timestamptz(6)
  mfaSecretEncrypted        String?                    @map("mfa_secret_encrypted") @db.Text
  mfaEnabledAt              DateTime?                  @map("mfa_enabled_at") @db.Timestamptz(6)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships               TenantMembership[]
  userRoles                 UserRole[]
  sessions                  Session[]
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  authTokens                AuthToken[]
  recoveryCodes             MfaRecoveryCode[]
  chatMessages              ChatMessage[]
  aiUsage                   AiUsage[]
  assignedTickets           Ticket[]                   @relation("TicketSpecialist")
  remediationAuthorizations RemediationAuthorization[] @relation("AuthorizationCustomer")
  remediationSessions       RemediationSession[]
  remediationRuns           RemediationRun[]
  warrantyClaims            WarrantyClaim[]
  createdPackageVersions    PackageVersion[]           @relation("PackageVersionCreator")
  createdSecurityFixPrices  SecurityFixPrice[]         @relation("SecurityFixPriceCreator")
  createdQuotes             Quote[]                    @relation("QuoteCreator")
  restoreAuthorizations     RestoreAuthorization[]     @relation("RestoreAuthorizer")
  developerModeChanges      DeveloperModeSetting[]     @relation("DeveloperModeActor")
  affiliateProfile          AffiliateProfile?
  createdAffiliatePrograms  AffiliateProgramConfig[]   @relation("AffiliateProgramCreator")
  affiliatePayoutChanges    AffiliatePayout[]          @relation("AffiliatePayoutActor")
  integrationChanges        PlatformIntegration[]      @relation("IntegrationActor")
  settingChanges            SystemSetting[]            @relation("SettingActor")
  notifications             Notification[]             @relation("NotificationRecipient")
  notificationPreferences   NotificationPreference[]
  communicationEvents       CommunicationEvent[]       @relation("CommunicationRecipient")
  emailDeliveries           EmailDelivery[]             @relation("EmailRecipient")
  emailTemplateVersions     EmailTemplateVersion[]      @relation("EmailTemplateCreator")
  requestedReports          Report[]                    @relation("ReportRequester")
  supportConversations      SupportConversation[]       @relation("SupportCustomer")
  assignedSupportChats      SupportConversation[]       @relation("SupportSpecialist")
  supportMessages           SupportMessage[]

  @@map("users")
}

model Tenant {
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String                     @db.VarChar(160)
  slug                      String                     @unique @db.VarChar(80)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships               TenantMembership[]
  roles                     Role[]
  userRoles                 UserRole[]
  sessions                  Session[]
  auditLogs                 AuditLog[]
  agencyClients             AgencyClientRelationship[] @relation("AgencyTenant")
  clientAgencies            AgencyClientRelationship[] @relation("ClientTenant")
  websites                  Website[]
  subscriptions             Subscription[]
  invoices                  Invoice[]
  notifications             Notification[]
  chatMessages              ChatMessage[]
  aiPolicy                  AiTenantPolicy?
  aiUsage                   AiUsage[]
  remediationAuthorizations RemediationAuthorization[]
  remediationSessions       RemediationSession[]
  remediationRuns           RemediationRun[]
  warrantyPolicy            WarrantyPolicy?
  warrantyClaims            WarrantyClaim[]
  paymentTransactions       PaymentTransaction[]
  securityFixOrders         SecurityFixOrder[]
  quotes                    Quote[]                    @relation("QuoteClientTenant")
  agencyQuotes              Quote[]                    @relation("QuoteAgencyTenant")
  agencyCommercePolicy      AgencyCommercePolicy?
  agencyPackageEntitlements AgencyPackageEntitlement[]
  affiliateProfile          AffiliateProfile?
  affiliateAttribution      ReferralAttribution?       @relation("AttributedCustomerTenant")
  affiliateConversions      AffiliateConversion[]
  affiliatePayouts          AffiliatePayout[]
  backupPolicies            BackupPolicy[]
  monitoringPolicies        MonitoringPolicy[]
  monitoringChecks          MonitoringCheck[]
  securityEvents            SecurityEvent[]
  securityAlerts            SecurityAlert[]
  restoreAuthorizations     RestoreAuthorization[]
  restoreOperations         RestoreOperation[]
  developerMode             DeveloperModeSetting?
  communicationEvents       CommunicationEvent[]
  notificationPreferences   NotificationPreference[]
  emailDeliveries           EmailDelivery[]
  reports                    Report[]
  websiteAccessCredentials   WebsiteAccessCredential[]
  supportConversations       SupportConversation[]

  @@map("tenants")
}

model Website {
  id                        String                     @id @default(uuid()) @db.Uuid
  tenantId                  String                     @map("tenant_id") @db.Uuid
  name                      String                     @db.VarChar(120)
  url                       String                     @db.VarChar(2048)
  normalizedHost            String                     @map("normalized_host") @db.VarChar(253)
  lifecycle                 WebsiteLifecycle           @default(ACTIVE)
  connectionStatus          ConnectionStatus           @default(PENDING) @map("connection_status")
  securityStatus            SecurityStatus             @default(UNKNOWN) @map("security_status")
  monitoringStatus          ServiceStatus              @default(NOT_CONFIGURED) @map("monitoring_status")
  backupStatus              ServiceStatus              @default(NOT_CONFIGURED) @map("backup_status")
  lastScanAt                DateTime?                  @map("last_scan_at") @db.Timestamptz(6)
  archivedAt                DateTime?                  @map("archived_at") @db.Timestamptz(6)
  connectedAt               DateTime?                  @map("connected_at") @db.Timestamptz(6)
  connectionErrorCode       String?                    @map("connection_error_code") @db.VarChar(120)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  findings                  SecurityFinding[]
  scans                     Scan[]
  tickets                   Ticket[]
  backups                   Backup[]
  reports                   Report[]
  chatMessages              ChatMessage[]
  verifications             WebsiteVerification[]
  evidence                  FindingEvidence[]
  remediationAuthorizations RemediationAuthorization[]
  remediationSessions       RemediationSession[]
  remediationRuns           RemediationRun[]
  warrantyClaims            WarrantyClaim[]
  backupPolicy              BackupPolicy?
  monitoringPolicy          MonitoringPolicy?
  monitoringChecks          MonitoringCheck[]
  securityEvents            SecurityEvent[]
  securityAlerts            SecurityAlert[]
  restoreAuthorizations     RestoreAuthorization[]
  restoreOperations         RestoreOperation[]
  accessCredential          WebsiteAccessCredential?
  securityFixOrders         SecurityFixOrder[]

  @@unique([tenantId, normalizedHost])
  @@index([tenantId, lifecycle])
  @@map("websites")
}

model WebsiteVerification {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  websiteId  String             @map("website_id") @db.Uuid
  tokenHash  String             @unique @map("token_hash") @db.Char(64)
  method     VerificationMethod
  status     VerificationStatus @default(PENDING)
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime?          @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  website    Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([tenantId, websiteId, status])
  @@map("website_verifications")
}

model WebsiteAccessCredential {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  websiteId       String   @unique @map("website_id") @db.Uuid
  host            String   @db.VarChar(253)
  port            Int      @default(22)
  username        String   @db.VarChar(120)
  authMethod      String   @map("auth_method") @db.VarChar(20)
  encryptedSecret String   @map("encrypted_secret") @db.Text
  hostKeyFingerprint String? @map("host_key_fingerprint") @db.VarChar(128)
  status          String   @default("CONFIGURED") @db.VarChar(32)
  lastCheckedAt   DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastErrorCode   String?  @map("last_error_code") @db.VarChar(120)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  website         Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("website_access_credentials")
}

model SecurityFinding {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  websiteId            String            @map("website_id") @db.Uuid
  scanId               String            @map("scan_id") @db.Uuid
  fingerprint          String            @db.Char(64)
  title                String            @db.VarChar(240)
  description          String?           @db.Text
  severity             FindingSeverity
  confidence           Decimal           @db.Decimal(4, 3)
  status               FindingStatus     @default(OPEN)
  affectedResource     String            @map("affected_resource") @db.VarChar(2048)
  recommendation       String            @db.Text
  cwe                  String?           @db.VarChar(32)
  cve                  String?           @db.VarChar(32)
  owaspCategory        String?           @map("owasp_category") @db.VarChar(64)
  remediationSupported Boolean           @default(false) @map("remediation_supported")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  website              Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  scan                 Scan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  tickets              Ticket[]
  messages             ChatMessage[]
  evidence             FindingEvidence[]
  securityFixOrders    SecurityFixOrder[]

  @@unique([scanId, fingerprint])
  @@index([tenantId, websiteId, status])
  @@map("security_findings")
}

model Scan {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  websiteId        String            @map("website_id") @db.Uuid
  status           JobStatus         @default(QUEUED)
  requestedAt      DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt        DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)
  errorCode        String?           @map("error_code") @db.VarChar(120)
  progress         Int               @default(0)
  engineCount      Int               @default(0) @map("engine_count")
  completedEngines Int               @default(0) @map("completed_engines")
  finalUrl         String?           @map("final_url") @db.VarChar(2048)
  attemptCount     Int               @default(0) @map("attempt_count")
  website          Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  findings         SecurityFinding[]
  evidence         FindingEvidence[]

  @@index([tenantId, websiteId, requestedAt])
  @@map("scans")
}

model FindingEvidence {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  websiteId     String          @map("website_id") @db.Uuid
  scanId        String          @map("scan_id") @db.Uuid
  findingId     String          @map("finding_id") @db.Uuid
  engine        String          @db.VarChar(120)
  engineVersion String          @map("engine_version") @db.VarChar(40)
  observedAt    DateTime        @map("observed_at") @db.Timestamptz(6)
  summary       String          @db.Text
  metadata      Json
  integrityHash String          @map("integrity_hash") @db.Char(64)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  website       Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  scan          Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  finding       SecurityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([tenantId, websiteId, scanId])
  @@index([findingId])
  @@map("finding_evidence")
}

model Ticket {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @map("tenant_id") @db.Uuid
  websiteId            String                     @map("website_id") @db.Uuid
  findingId            String?                    @map("finding_id") @db.Uuid
  title                String                     @db.VarChar(240)
  description          String?                    @db.Text
  status               TicketStatus               @default(CREATED)
  assignedSpecialistId String?                    @map("assigned_specialist_id") @db.Uuid
  assignmentExpiresAt  DateTime?                  @map("assignment_expires_at") @db.Timestamptz(6)
  acceptedAt           DateTime?                  @map("accepted_at") @db.Timestamptz(6)
  escalatedAt          DateTime?                  @map("escalated_at") @db.Timestamptz(6)
  progressStage        String                     @default("REQUESTED") @map("progress_stage") @db.VarChar(40)
  progressNote         String?                    @map("progress_note") @db.VarChar(500)
  progressUpdatedAt    DateTime?                  @map("progress_updated_at") @db.Timestamptz(6)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  website              Website                    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  finding              SecurityFinding?           @relation(fields: [findingId], references: [id], onDelete: SetNull)
  messages             ChatMessage[]
  assignedSpecialist   User?                      @relation("TicketSpecialist", fields: [assignedSpecialistId], references: [id], onDelete: SetNull)
  authorizations       RemediationAuthorization[]
  backups              Backup[]
  specialistSessions   RemediationSession[]
  remediationRuns      RemediationRun[]
  warrantyClaims       WarrantyClaim[]
  securityAlert        SecurityAlert?
  securityFixOrder     SecurityFixOrder?

  @@index([tenantId, websiteId, status])
  @@map("tickets")
}

model Backup {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  websiteId             String                 @map("website_id") @db.Uuid
  ticketId              String?                @map("ticket_id") @db.Uuid
  purpose               BackupPurpose          @default(MANUAL)
  status                JobStatus              @default(QUEUED)
  requestedAt           DateTime               @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt           DateTime?              @map("completed_at") @db.Timestamptz(6)
  errorCode             String?                @map("error_code") @db.VarChar(120)
  verifiedAt            DateTime?              @map("verified_at") @db.Timestamptz(6)
  restoreReference      String?                @map("restore_reference") @db.VarChar(500)
  integrityHash         String?                @map("integrity_hash") @db.Char(64)
  sizeBytes             BigInt?                @map("size_bytes")
  encryption            Json?
  retentionUntil        DateTime?              @map("retention_until") @db.Timestamptz(6)
  protectedUntil        DateTime?              @map("protected_until") @db.Timestamptz(6)
  deleteRequestedAt     DateTime?              @map("delete_requested_at") @db.Timestamptz(6)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)
  providerKey           String?                @map("provider_key") @db.VarChar(120)
  website               Website                @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  ticket                Ticket?                @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  remediationRuns       RemediationRun[]
  restoreAuthorizations RestoreAuthorization[]
  restoreOperations     RestoreOperation[]

  @@index([tenantId, websiteId, requestedAt])
  @@map("backups")
}

model BackupPolicy {
  websiteId         String    @id @map("website_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  enabled           Boolean   @default(false)
  frequencyHours    Int       @default(24) @map("frequency_hours")
  retentionDays     Int       @default(30) @map("retention_days")
  restorePointLimit Int       @default(30) @map("restore_point_limit")
  nextBackupAt      DateTime? @map("next_backup_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  website           Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled, nextBackupAt])
  @@map("backup_policies")
}

model MonitoringPolicy {
  websiteId            String    @id @map("website_id") @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  enabled              Boolean   @default(false)
  intervalMinutes      Int       @default(60) @map("interval_minutes")
  alertCooldownMinutes Int       @default(60) @map("alert_cooldown_minutes")
  indicators           Json      @default("{}")
  nextCheckAt          DateTime? @map("next_check_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  website              Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled, nextCheckAt])
  @@map("monitoring_policies")
}

model MonitoringCheck {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  websiteId       String          @map("website_id") @db.Uuid
  jobId           String          @unique @map("job_id") @db.VarChar(160)
  status          JobStatus       @default(RUNNING)
  snapshot        Json?
  snapshotHash    String?         @map("snapshot_hash") @db.Char(64)
  resolvedAddress String?         @map("resolved_address") @db.Inet
  responseTimeMs  Int?            @map("response_time_ms")
  errorCode       String?         @map("error_code") @db.VarChar(120)
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  website         Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  events          SecurityEvent[]

  @@index([tenantId, websiteId, startedAt])
  @@map("monitoring_checks")
}

model SecurityEvent {
