  resourceType String   @map("resource_type") @db.VarChar(120)
  resourceId   String?  @map("resource_id") @db.VarChar(120)
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.Inet
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

model AgencyClientRelationship {
  id             String                   @id @default(uuid()) @db.Uuid
  agencyTenantId String                   @map("agency_tenant_id") @db.Uuid
  clientTenantId String                   @map("client_tenant_id") @db.Uuid
  status         AgencyClientStatus       @default(PENDING)
  permissions    AgencyClientPermission[] @default([])
  activatedAt    DateTime?                @map("activated_at") @db.Timestamptz(6)
  revokedAt      DateTime?                @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  agencyTenant   Tenant                   @relation("AgencyTenant", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant   Tenant                   @relation("ClientTenant", fields: [clientTenantId], references: [id], onDelete: Cascade)
  quotes         Quote[]

  @@unique([agencyTenantId, clientTenantId])
  @@index([clientTenantId, status])
  @@map("agency_client_relationships")
}

model AgencyCommercePolicy {
  id                      String   @id @default(uuid()) @db.Uuid
  agencyTenantId          String   @unique @map("agency_tenant_id") @db.Uuid
  markupBasisPoints       Int      @default(0) @map("markup_basis_points")
  maxDiscountBasisPoints  Int      @default(0) @map("max_discount_basis_points")
  revenueShareBasisPoints Int      @default(0) @map("revenue_share_basis_points")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  agencyTenant            Tenant   @relation(fields: [agencyTenantId], references: [id], onDelete: Cascade)

  @@map("agency_commerce_policies")
}

model AgencyPackageEntitlement {
  id               String         @id @default(uuid()) @db.Uuid
  agencyTenantId   String         @map("agency_tenant_id") @db.Uuid
  packageVersionId String         @map("package_version_id") @db.Uuid
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  agencyTenant     Tenant         @relation(fields: [agencyTenantId], references: [id], onDelete: Cascade)
  packageVersion   PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)

  @@unique([agencyTenantId, packageVersionId])
  @@index([packageVersionId, enabled])
  @@map("agency_package_entitlements")
}

model AffiliateProfile {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @unique @map("tenant_id") @db.Uuid
  userId       String                @unique @map("user_id") @db.Uuid
  code         String                @unique @db.VarChar(32)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  attributions ReferralAttribution[]
  conversions  AffiliateConversion[]
  commissions  AffiliateCommission[]
  payouts      AffiliatePayout[]

  @@map("affiliate_profiles")
}

model AffiliateProgramConfig {
  id                      String                     @id @default(uuid()) @db.Uuid
  version                 Int                        @unique
  active                  Boolean                    @default(false)
  attributionWindowDays   Int                        @map("attribution_window_days")
  attributionModel        AttributionModel           @map("attribution_model")
  commissionKind          CommissionKind             @map("commission_kind")
  calculation             CommissionCalculation
  percentageBasisPoints   Int?                       @map("percentage_basis_points")
  fixedAmountMinor        Int?                       @map("fixed_amount_minor")
  recurringDurationMonths Int                        @default(1) @map("recurring_duration_months")
  payoutThresholdMinor    Int                        @map("payout_threshold_minor")
  approvalRequired        Boolean                    @default(true) @map("approval_required")
  eligibilityRules        Json                       @default("{}") @map("eligibility_rules")
  createdByUserId         String                     @map("created_by_user_id") @db.Uuid
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy               User                       @relation("AffiliateProgramCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  eligibleProducts        AffiliateEligibleProduct[]
  attributions            ReferralAttribution[]
  conversions             AffiliateConversion[]

  @@index([active, createdAt])
  @@map("affiliate_program_configs")
}

model AffiliateEligibleProduct {
  id               String                 @id @default(uuid()) @db.Uuid
  configId         String                 @map("config_id") @db.Uuid
  packageVersionId String                 @map("package_version_id") @db.Uuid
  config           AffiliateProgramConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  packageVersion   PackageVersion         @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)

  @@unique([configId, packageVersionId])
  @@map("affiliate_eligible_products")
}

model ReferralAttribution {
  id               String                 @id @default(uuid()) @db.Uuid
  affiliateId      String                 @map("affiliate_id") @db.Uuid
  configId         String                 @map("config_id") @db.Uuid
  tokenHash        String                 @unique @map("token_hash") @db.Char(64)
  customerTenantId String?                @unique @map("customer_tenant_id") @db.Uuid
  status           AttributionStatus      @default(ACTIVE)
  attributedAt     DateTime               @default(now()) @map("attributed_at") @db.Timestamptz(6)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(6)
  convertedAt      DateTime?              @map("converted_at") @db.Timestamptz(6)
  affiliate        AffiliateProfile       @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  config           AffiliateProgramConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  customerTenant   Tenant?                @relation("AttributedCustomerTenant", fields: [customerTenantId], references: [id], onDelete: Restrict)
  conversions      AffiliateConversion[]

  @@index([affiliateId, status, attributedAt])
  @@map("referral_attributions")
}

model AffiliateConversion {
  id                   String                 @id @default(uuid()) @db.Uuid
  attributionId        String                 @map("attribution_id") @db.Uuid
  affiliateId          String                 @map("affiliate_id") @db.Uuid
  configId             String                 @map("config_id") @db.Uuid
  customerTenantId     String                 @map("customer_tenant_id") @db.Uuid
  paymentTransactionId String                 @unique @map("payment_transaction_id") @db.Uuid
  packageVersionId     String                 @map("package_version_id") @db.Uuid
  recurringPeriod      Int                    @map("recurring_period")
  convertedAt          DateTime               @default(now()) @map("converted_at") @db.Timestamptz(6)
  attribution          ReferralAttribution    @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  affiliate            AffiliateProfile       @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  config               AffiliateProgramConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  customerTenant       Tenant                 @relation(fields: [customerTenantId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction     @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  packageVersion       PackageVersion         @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  commission           AffiliateCommission?

  @@unique([attributionId, recurringPeriod])
  @@map("affiliate_conversions")
}

model AffiliateCommission {
  id             String              @id @default(uuid()) @db.Uuid
  conversionId   String              @unique @map("conversion_id") @db.Uuid
  affiliateId    String              @map("affiliate_id") @db.Uuid
  payoutId       String?             @map("payout_id") @db.Uuid
  amountMinor    Int                 @map("amount_minor")
  currency       String              @db.Char(3)
  status         CommissionStatus    @default(PENDING)
  ruleSnapshot   Json                @map("rule_snapshot")
  approvedAt     DateTime?           @map("approved_at") @db.Timestamptz(6)
  reversedAt     DateTime?           @map("reversed_at") @db.Timestamptz(6)
  reversalReason String?             @map("reversal_reason") @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  conversion     AffiliateConversion @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  affiliate      AffiliateProfile    @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  payout         AffiliatePayout?    @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([affiliateId, status, createdAt])
  @@map("affiliate_commissions")
}

model AffiliatePayout {
  id                String                @id @default(uuid()) @db.Uuid
  affiliateId       String                @map("affiliate_id") @db.Uuid
  affiliateTenantId String                @map("affiliate_tenant_id") @db.Uuid
  idempotencyKey    String                @unique @map("idempotency_key") @db.Uuid
  amountMinor       Int                   @map("amount_minor")
  currency          String                @db.Char(3)
  status            AffiliatePayoutStatus @default(PENDING)
  providerReference String?               @unique @map("provider_reference") @db.VarChar(255)
  failureCode       String?               @map("failure_code") @db.VarChar(120)
  changedByUserId   String?               @map("changed_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidAt            DateTime?             @map("paid_at") @db.Timestamptz(6)
  affiliate         AffiliateProfile      @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  affiliateTenant   Tenant                @relation(fields: [affiliateTenantId], references: [id], onDelete: Restrict)
  changedBy         User?                 @relation("AffiliatePayoutActor", fields: [changedByUserId], references: [id], onDelete: SetNull)
  commissions       AffiliateCommission[]

  @@index([affiliateId, status, createdAt])
  @@map("affiliate_payouts")
}

model PlatformIntegration {
  id                   String                  @id @default(uuid()) @db.Uuid
  type                 IntegrationType
  name                 String                  @db.VarChar(120)
  adapterKey           String                  @map("adapter_key") @db.VarChar(100)
  enabled              Boolean                 @default(false)
  encryptedCredentials String?                 @map("encrypted_credentials") @db.Text
  configuration        Json                    @default("{}")
  healthStatus         IntegrationHealthStatus @default(NOT_CONFIGURED) @map("health_status")
  lastHealthCheckAt    DateTime?               @map("last_health_check_at") @db.Timestamptz(6)
  changedByUserId      String                  @map("changed_by_user_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  changedBy            User                    @relation("IntegrationActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@unique([type, name])
  @@index([type, enabled, healthStatus])
  @@map("platform_integrations")
}

model SystemSetting {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique @db.VarChar(120)
  value             Json
  description       String   @db.VarChar(500)
  securityInvariant Boolean  @default(false) @map("security_invariant")
  changedByUserId   String   @map("changed_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  changedBy         User     @relation("SettingActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@map("system_settings")
}
